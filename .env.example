# Smart Gate Desktop Configuration
API_BASE_URL=http://localhost:8000
ENV_MODE=DEV

# Sign-in mode
#   mock   — the desktop collects email + password and drives /auth/desktop/start
#            itself (reference server).
#   portal — the operator signs in on the SIT portal in a browser, the portal
#            mints the one-time code and the desktop only exchanges it. No
#            credential is ever typed into the app.
# Portal base URL for production:
#   API_BASE_URL=https://sit-portal-e6750.web.app/api/gate
#   (fallback: https://us-central1-sit-portal-e6750.cloudfunctions.net/gateAuth)
AUTH_MODE=mock
# The app appends ?client=smart-gate&device_id=<this device's id>
PORTAL_SSO_URL=https://sit-portal-e6750.web.app/sso

# Endpoints (override only if server paths change)
# Auth — the desktop uses the two-step start/exchange flow; AUTH_ENDPOINT is
# the legacy direct login kept for admin/testing only.
AUTH_ENDPOINT=/auth/login
AUTH_DESKTOP_START_ENDPOINT=/auth/desktop/start
AUTH_DESKTOP_EXCHANGE_ENDPOINT=/auth/desktop/exchange
AUTH_REFRESH_ENDPOINT=/auth/refresh
# Portal only — revokes the session server-side on logout (best-effort).
AUTH_LOGOUT_ENDPOINT=/auth/logout
# Devices
DEVICES_REGISTER_ENDPOINT=/devices/register
DEVICES_CHECK_ENDPOINT=/devices/check
DEVICES_HEARTBEAT_ENDPOINT=/devices/heartbeat
# Sync
SYNC_ALLOWLIST_ENDPOINT=/sync/allowlist
SYNC_MANUAL_REASONS_ENDPOINT=/sync/manual-reasons
# Events
EVENTS_ENDPOINT=/events
EVENTS_BATCH_ENDPOINT=/events/batch
# Vehicles / permits
VEHICLES_LOOKUP_ENDPOINT=/vehicles/lookup
PERMITS_TEMPORARY_ENDPOINT=/permits/temporary
VEHICLES_REGISTER_VISITOR_ENDPOINT=/vehicles/register-visitor

# Gate configuration
# NOTE: the server's /devices/check assignment overrides GATE_ID / LANE_ID at
# sign-in; these values are the pre-registration defaults.
GATE_ID=GATE-1
LANE_ID=LANE-A
DIRECTION=ENTRY
DEVICE_NAME=Gate-1-Lane-A

# Camera configuration
# Settings → Cameras is the place to change these: it scans for attached USB
# cameras, takes IP cameras by URL, and lets you say what each one is for.
#
# CAMERAS is the full list, written as one line of JSON by the settings page:
#   [{"id":"cam-plate","name":"Lane camera","kind":"RTSP","index":0,
#     "url":"rtsp://...","role":"plate"},
#    {"id":"cam-face","name":"Booth webcam","kind":"USB","index":0,
#     "url":"","role":"face"}]
# role is "plate" (ALPR), "face" (attendance) or "unused". Each role runs on at
# most one camera. Leave CAMERAS unset and the pair below is used instead, so an
# existing station upgrades without changing anything.
#
# CAMERA_MODE: USB (laptop/webcam via CAMERA_INDEX) or RTSP (IP camera via CAMERA_RTSP_URL)
CAMERA_MODE=USB
CAMERA_INDEX=0
# Hikvision RTSP URL format:
#   rtsp://<user>:<password>@<camera-ip>:554/Streaming/Channels/<channel>
#   channel 101 = main stream (8MP — heavy to decode), 102 = sub-stream (recommended for ALPR).
#   In the camera web UI set the sub-stream to 1920x1080 @ 20-25fps, H.264.
#   Example: rtsp://admin:MyPassw0rd@192.168.1.64:554/Streaming/Channels/102
CAMERA_RTSP_URL=

# Plate read zone (software zoom).
# When the lane camera has to watch a whole yard, the cars pass through one
# small part of the frame and the plate reaches the AI a dozen pixels wide.
# Give the AI just that region, at full resolution: x,y,w,h as fractions of
# the frame (0-1). The preview outlines the zone in orange so you can aim it.
# Example — right half of the frame, starting a quarter of the way down:
#   ALPR_ROI=0.5,0.25,0.5,0.6
# Empty = read the entire frame.
ALPR_ROI=

# Evidence and sync
EVIDENCE_DIR=
SYNC_INTERVAL_SECONDS=10

# Auto-decision
# Seconds the GREEN (recognized & allowed) state counts down before it
# auto-confirms ALLOW. The guard can always abort with the STOP button.
# Set to 0 to disable auto-continue — every decision then stays manual.
AUTO_ALLOW_SECONDS=5

# Staff face attendance
# The station's second job: recognise staff at the window and queue an
# attendance punch. Entirely independent of the gate — a station with no webcam,
# or one where the dlib/face_recognition stack failed to build, sets
# FACE_ATTENDANCE_ENABLED=false and behaves exactly like a plain gate PC.
FACE_ATTENDANCE_ENABLED=true
# The webcam watching the window, NOT the lane camera above (CAMERA_INDEX).
FACE_CAMERA_INDEX=0
# Recognition passes per second. The ALPR thread already runs a 640x640 ONNX
# detector + OCR at 5 fps on this CPU; much above 3 and the two starve each
# other. Detection runs on a half-scale frame to stay inside that budget.
FACE_MAX_FPS=3
# Match thresholds, from the department's existing attendance system
# (verify_face_with_confidence). A face must satisfy BOTH: distance within
# FACE_TOLERANCE and confidence at or above FACE_MIN_CONFIDENCE. Lowering the
# tolerance makes recognition stricter (fewer false matches, more misses).
FACE_TOLERANCE=0.50
FACE_MIN_CONFIDENCE=45.0

# Attendance endpoints
SYNC_STAFF_ROSTER_ENDPOINT=/sync/staff-roster
ATTENDANCE_BATCH_ENDPOINT=/attendance/batch

# Spoken output (attendance announcements)
# TTS_VOICE — which voice to use. Run `python scripts/list_voices.py` to see
#   what THIS machine offers and test them (`--test N` speaks a sample).
#   pyttsx3 engine: any part of a voice name/id, e.g. zira, david, female.
#   spd-say fallback (Linux without libespeak1): MALE1..3, FEMALE1..3,
#   CHILD_MALE, CHILD_FEMALE.
# TTS_RATE — words per minute: ~120 slow, 170 normal, ~220 fast.
# TTS_VOLUME — 0.0 to 1.0.
TTS_VOICE=
TTS_RATE=170
TTS_VOLUME=1.0
