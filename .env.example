# Smart Gate Desktop Configuration
API_BASE_URL=http://localhost:8000
ENV_MODE=DEV

# Endpoints (override only if server paths change)
AUTH_ENDPOINT=/auth/login
DEVICES_REGISTER_ENDPOINT=/devices/register
SYNC_ALLOWLIST_ENDPOINT=/sync/allowlist
SYNC_MANUAL_REASONS_ENDPOINT=/sync/manual-reasons
EVENTS_ENDPOINT=/events
DEVICES_HEARTBEAT_ENDPOINT=/devices/heartbeat
VEHICLES_LOOKUP_ENDPOINT=/vehicles/lookup
VEHICLES_REGISTER_ENDPOINT=/vehicles/register

# Gate configuration
GATE_ID=GATE-1
LANE_ID=LANE-A
DIRECTION=ENTRY
DEVICE_NAME=Gate-1-Lane-A

# Camera configuration
CAMERA_MODE=USB
CAMERA_INDEX=0
CAMERA_RTSP_URL=

# Evidence and sync
EVIDENCE_DIR=
SYNC_INTERVAL_SECONDS=10
